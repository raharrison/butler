<!--
  Logs go to stderr; stdout carries what a command was asked for (a plan, a run report, the
  effective config). run_id, job and step come from the MDC the runner sets.

  This is the text format an interactive command wants and always gets. The daemon replaces it at
  startup when settings.log_format asks for JSON; see cli/Logging.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <!-- One line. The %replace calls put a space before job and brackets around step only
                 when the MDC has them, so a line logged outside a run has neither. Do not wrap
                 this: a newline inside a replacement string ends up in every line it matches. -->
            <pattern>%d{HH:mm:ss.SSS} %-5level %X{run_id:-}%replace(%X{job:-}){'^(.+)$',' $1'}%replace(%X{step:-}){'^(.+)$','
                [$1]'} %msg%n
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
